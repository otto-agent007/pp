NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BRAND_KEY=
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# Public by construction: only set on a demo deployment, and only alongside a
# demo-only Supabase project. See the demo data section of README.md.
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=
# Server-only. Required to seed demo data in any built deployment.
DEMO_SEED_ADMIN_PASSWORD=
# Server-only. A preview seed or reset has to present this as an
# x-demo-seed-secret header; being configured is not enough. Keeps the admin UI
# from seeding a shared preview, since a browser cannot hold it.
DEMO_SEED_PREVIEW_SECRET=
# Server-only. The one Supabase project a preview demo seed may write to,
# matched against NEXT_PUBLIC_SUPABASE_URL. Unset means no project is allowed:
# previews otherwise point at whatever project the deployment is configured
# with, which is how demo seeding reached production data.
DEMO_SEED_ALLOWED_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-only. Replay window for the Stripe signature timestamp, in seconds.
# Unset means 300; values above 900 are clamped to 900.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=
STRIPE_LIVE_MODE_APPROVED=false
NOTIFICATION_DELIVERY_WEBHOOK_URL=
NOTIFICATION_DELIVERY_WEBHOOK_SECRET=
PORTAL_DELIVERY_WEBHOOK_URL=
PORTAL_DELIVERY_WEBHOOK_SECRET=
CRON_SECRET=
AUTOMATION_CRON_SECRET=
# Server-only. The id of the single Vercel Firewall rate-limit rule every API
# policy is pointed at, because the Hobby plan allows exactly one rule per
# project. Unset, each policy id is sent to the firewall as its own rule name,
# no such rule exists, and every route fails open with a rate_limit.fail_open
# log line -- so leaving this blank on Vercel disables API rate limiting.
VERCEL_FIREWALL_RATE_LIMIT_ID=
OPENAI_API_KEY=
OPENAI_COMPLIANCE_EMBEDDING_MODEL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_BRAND_KEY=
