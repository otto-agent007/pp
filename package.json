{
  "name": "pest-patrol-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:voice": "tsx tooling/dev-voice.ts",
    "voice:dev": "tsx tooling/dev-voice.ts --helper-only",
    "voice:health": "tsx tooling/voice-health.ts",
    "build": "turbo build",
    "architecture:check": "node --import tsx tooling/architecture-boundaries.ts",
    "brand:generate-svgs": "tsx tooling/generate-brand-svgs.ts",
    "compliance:ingest": "tsx tooling/compliance-ingest.ts",
    "demo:reset": "tsx tooling/demo-seed.ts reset",
    "demo:seed": "tsx tooling/demo-seed.ts seed",
    "demo:fixture-smoke": "tsx tooling/local-fixture-smoke.ts",
    "demo:smoke": "tsx tooling/demo-smoke-preflight.ts",
    "lint": "tsx tooling/no-hardcoded-hex.ts && eslint \"tooling/**/*.ts\" && turbo lint",
    "tokens:no-hardcoded-hex": "tsx tooling/no-hardcoded-hex.ts",
    "test": "vitest run --dir tooling && turbo test",
    "typecheck": "tsc -p tsconfig.tooling.json && turbo typecheck",
    "format": "prettier --write .",
    "rebuild:graph:check": "node --import tsx tooling/rebuild-graph.ts",
    "rebuild:graph:reconcile": "node --import tsx tooling/rebuild-graph-reconcile.ts",
    "rebuild:source-tag": "node --import tsx tooling/rebuild-source-tag.ts",
    "rebuild:verify": "node --import tsx tooling/rebuild-verification.ts",
    "security:audit": "pnpm audit",
    "security:baseline": "tsx tooling/security-baseline-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
