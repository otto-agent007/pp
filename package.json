{
  "name": "pest-patrol-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:voice": "tsx tooling/dev-voice.ts",
    "voice:dev": "tsx tooling/dev-voice.ts --helper-only",
    "voice:health": "tsx tooling/voice-health.ts",
    "build": "turbo build",
    "brand:generate-svgs": "tsx tooling/generate-brand-svgs.ts",
    "compliance:ingest": "tsx tooling/compliance-ingest.ts",
    "demo:reset": "tsx tooling/demo-seed.ts reset",
    "demo:seed": "tsx tooling/demo-seed.ts seed",
    "demo:fixture-smoke": "tsx tooling/local-fixture-smoke.ts",
    "demo:smoke": "tsx tooling/demo-smoke-preflight.ts",
    "lint": "tsx tooling/no-hardcoded-hex.ts && turbo lint",
    "tokens:no-hardcoded-hex": "tsx tooling/no-hardcoded-hex.ts",
    "test": "vitest run tooling/compliance-ingest.test.ts tooling/security-baseline-check.test.ts tooling/rebuild-graph.test.ts tooling/rebuild-graph-reconcile.test.ts tooling/rebuild-verification.test.ts && turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "rebuild:graph:check": "node --import tsx tooling/rebuild-graph.ts",
    "rebuild:graph:reconcile": "node --import tsx tooling/rebuild-graph-reconcile.ts",
    "rebuild:verify": "node --import tsx tooling/rebuild-verification.ts",
    "security:audit": "pnpm audit",
    "security:baseline": "tsx tooling/security-baseline-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.115.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "8.57.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@expo/cli>undici": "^6.28.0",
      "@expo/server>undici": "^7.29.0",
      "@expo/xcpretty>js-yaml": "^4.3.1",
      "@istanbuljs/load-nyc-config>js-yaml": "^3.15.1",
      "cosmiconfig>js-yaml": "^3.15.1",
      "minimatch@3.1.5>brace-expansion": "^1.1.18",
      "minimatch@9.0.9>brace-expansion": "^2.1.4",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "shell-quote": "^1.10.0",
      "tar": "^7.5.22",
      "xcode>uuid": "^11.1.1",
      "next>sharp": "^0.35.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-vcc3-ghjq-m6fr"
      ]
    }
  }
}
