{
  "name": "pest-patrol-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:voice": "tsx tooling/dev-voice.ts",
    "voice:dev": "tsx tooling/dev-voice.ts --helper-only",
    "voice:health": "tsx tooling/voice-health.ts",
    "build": "turbo build",
    "brand:generate-svgs": "tsx tooling/generate-brand-svgs.ts",
    "compliance:ingest": "tsx tooling/compliance-ingest.ts",
    "demo:reset": "tsx tooling/demo-seed.ts reset",
    "demo:seed": "tsx tooling/demo-seed.ts seed",
    "demo:fixture-smoke": "tsx tooling/local-fixture-smoke.ts",
    "demo:smoke": "tsx tooling/demo-smoke-preflight.ts",
    "lint": "tsx tooling/no-hardcoded-hex.ts && turbo lint",
    "tokens:no-hardcoded-hex": "tsx tooling/no-hardcoded-hex.ts",
    "test": "vitest run tooling/compliance-ingest.test.ts && turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.51.1",
    "@supabase/supabase-js": "^2.47.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "8.57.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "tsx": "^4.22.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.16",
      "@xmldom/xmldom": "0.9.10",
      "postcss": "8.5.15",
      "ws": "8.21.0",
      "uuid": "11.1.1"
    }
  }
}
